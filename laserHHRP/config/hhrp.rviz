# RViz 2 layout of the operator UI (launch/ui.launch.py): operator panel on the left, 3D view on the right.
# 3D view: the live laser profile (/laser/profile) and the 3D scan (/scan/cloud_view, from point_cloud_node).
Panels:
  - Class: laser_hhrp/OperatorPanel
    Name: Operator
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.01
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Axes
      Name: Laser frame
      Enabled: true
      Length: 0.02
      Radius: 0.002
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Live profile
      Enabled: true
      Topic:
        Value: /laser/profile
        Depth: 5
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 0; 255; 0
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: 3D scan
      Enabled: true
      Topic:
        Value: /scan/cloud_view
        Depth: 5
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0
      Value: true
  Global Options:
    Fixed Frame: laser
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 0.25
      Focal Point: { X: 0, Y: 0, Z: 0.05 }
      Pitch: 0.5
      Yaw: 0.8
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
Window Geometry:
  X: 0
  Y: 0
  Width: 1280
  Height: 720
  Hide Left Dock: false
  Hide Right Dock: true
  Displays:
    collapsed: true
  Operator:
    collapsed: false
